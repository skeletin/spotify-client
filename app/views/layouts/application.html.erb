<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Spotify Client" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Spotify Client">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application.jsx' %>
        <%= vite_javascript_tag 'application' %>
  </head>

  <body>

    <% if current_page?(root_path) %>
      <main>
        <%= yield %>
      </main>
    <% else  %>
      <main>
        <div class="flex h-full w-full flex-col gap-4 bg-[#121212] p-4 md:p-8 font-sans">
          <div class="flex flex-1 flex-col gap-4 lg:flex-row">
              <%= render NavigationComponent.new %>
              <div class="min-w-0 flex-1">
                <%= yield %>
              </div>
          </div>
          <%= render MusicPlayerComponent.new %>
        </div>
      </main>
    <% end %>
  </body>
</html>
