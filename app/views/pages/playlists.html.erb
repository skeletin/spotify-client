<section class="w-full rounded-2xl border border-white/10 bg-[#191414] p-5 shadow-xl md:p-6" role="region" aria-label="Spotify playlists">
  <header class="mb-5 flex flex-wrap items-center gap-2">
    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#1db954]" aria-hidden="true">
      <svg class="h-3 w-3 text-black" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02z"/></svg>
    </span>
    <div>
      <p class="text-[10px] uppercase tracking-[0.2em] text-slate-400">From Spotify</p>
      <h1 class="mt-1 text-2xl font-bold text-white md:text-3xl">Your Playlists</h1>
      <p class="mt-1 text-sm text-slate-400">Content from your Spotify account.</p>
    </div>
  </header>

  <% if @playlists.present? %>
    <div class="space-y-3">
      <%= render PlaylistCardComponent.with_collection(@playlists) %>
    </div>
    <p class="mt-6 text-center">
      <%= link_to "Keep exploring on Spotify →", "https://open.spotify.com", target: "_blank", rel: "noopener noreferrer", class: "text-sm font-medium text-[#1db954] hover:underline" %>
    </p>
  <% else %>
    <div class="rounded-xl border border-white/10 bg-black/40 p-5 text-sm text-slate-300/75">
      No playlists found yet.
    </div>
  <% end %>
</section>
